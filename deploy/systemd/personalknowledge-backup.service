# __USER__ / __APP_DIR__ はプレースホルダ。設置時に置換すること（docs/operations.md STEP 6 参照）。
[Unit]
Description=Personal Knowledge encrypted SQLite backup to Google Drive
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=__USER__
WorkingDirectory=__APP_DIR__
# .env は dotenv/config が WorkingDirectory から読む（EnvironmentFile は使わない）。
ExecStart=/usr/bin/node dist/backup/cli.js backup
