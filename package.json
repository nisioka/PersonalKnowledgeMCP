{
  "name": "personal-knowledge-mcp",
  "version": "0.2.0",
  "mcpName": "io.github.nisioka/personal-knowledge-mcp",
  "description": "Self-hosted MCP server for a personal knowledge base: scoped search, ingestion, expiry reminders",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "claude",
    "knowledge-base",
    "self-hosted",
    "sqlite",
    "sqlite-vec",
    "full-text-search",
    "reminders"
  ],
  "license": "MIT",
  "author": "nisioka (https://github.com/nisioka)",
  "homepage": "https://github.com/nisioka/PersonalKnowledgeMCP#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nisioka/PersonalKnowledgeMCP.git"
  },
  "bugs": {
    "url": "https://github.com/nisioka/PersonalKnowledgeMCP/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.8.0",
  "bin": {
    "pk-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "backup": "node dist/backup/cli.js backup",
    "restore": "node dist/backup/cli.js restore",
    "db:encrypt": "node dist/db/rekey-cli.js encrypt",
    "db:decrypt": "node dist/db/rekey-cli.js decrypt",
    "reminders": "node dist/reminders/cli.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "better-sqlite3-multiple-ciphers": "^12.11.1",
    "dotenv": "^17.4.2",
    "express": "^5.1.0",
    "googleapis": "^173.0.0",
    "sqlite-vec": "^0.1.7-alpha.2",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.0",
    "@types/node": "^22.15.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
